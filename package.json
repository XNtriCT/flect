{
  "name": "flect",
  "productName": "FLECT",
  "version": "1.1.0",
  "description": "FLECT — an AI-powered manuscript editor for authors",
  "main": "electron/main.js",
  "author": "XNtriCT",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XNtriCT/flect.git"
  },
  "homepage": "https://github.com/XNtriCT/flect#readme",
  "bugs": {
    "url": "https://github.com/XNtriCT/flect/issues"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test:e2e": "node scripts/e2e.mjs",
    "test:artifacts": "node scripts/verify-artifacts.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:static": "node scripts/check-static.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "marked": "^14.1.3",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "docx": "^9.0.3",
    "jszip": "^3.10.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "@tiptap/extension-character-count": "^2.10.3",
    "@tiptap/extension-color": "^2.10.3",
    "@tiptap/extension-font-family": "^2.10.3",
    "@tiptap/extension-highlight": "^2.10.3",
    "@tiptap/extension-image": "^2.10.3",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-subscript": "^2.10.3",
    "@tiptap/extension-superscript": "^2.10.3",
    "@tiptap/extension-table": "^2.10.3",
    "@tiptap/extension-table-cell": "^2.10.3",
    "@tiptap/extension-table-header": "^2.10.3",
    "@tiptap/extension-table-row": "^2.10.3",
    "@tiptap/extension-text-align": "^2.10.3",
    "@tiptap/extension-text-style": "^2.10.3",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.flect.editor",
    "productName": "FLECT",
    "copyright": "Copyright © 2026 FLECT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "FLECT-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FLECT",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
